# Duplex broker — environment template.
# Copy this file to .env.local and fill in your key. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# The broker loads .env.local from the repo root at startup.

# --- required ---------------------------------------------------------------

# Your OpenAI API key with GPT-Live access. Stays server-side; the browser never sees it.
OPENAI_API_KEY=sk-...

# --- optional overrides (defaults shown) ------------------------------------

# The voice model id. This is the swap seam for our own model later.
# DUPLEX_MODEL=gpt-live-1

# The backend "brain" LLM that picks tools during a delegation.
# DUPLEX_BRAIN_MODEL=gpt-6-luna

# The default system prompt for a session (overrides the built-in friendly-assistant prompt).
# DUPLEX_INSTRUCTIONS=You are a friendly voice assistant. Keep replies short.

# Comma-separated list of browser origins allowed to call this broker (CORS).
# Local default:
# DUPLEX_ALLOWED_ORIGINS=http://localhost:3000
# Deployed (point this at the frontend's own URL, e.g. on Render):
# DUPLEX_ALLOWED_ORIGINS=https://duplex-frontend.onrender.com
